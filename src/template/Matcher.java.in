package io.github.corvusdotnet.regex.ecma262;

import java.util.Arrays;

/**
 * The backtracking matcher over $INPUT$ text ({@code vm.rs}, which is {@code vm.go}). The template is expanded once for
 * each encoding by tools/expand.py, as Rust's generics make one matcher for each.
 */
final class Matcher$T$ {
    private Matcher$T$() {}

    /** The result of {@link #exec} for no match, and for a match abandoned at its limit of time or of memory. */
    static final long NO_MATCH = -1L;
    static final long STOPPED_TIME = -2L;
    static final long STOPPED_MEMORY = -3L;

    static long span(int from, int to) {
        return (long) from << 32 | (to & 0xFFFFFFFFL);
    }

    /**
     * Finds the first match at or after {@code start} (at {@code start} alone with {@code sticky}), and returns where
     * it starts and ends packed by {@link #span}, or one of NO_MATCH, STOPPED_TIME and STOPPED_MEMORY. When it finds
     * one and {@code caps} is given, {@code caps} receives from {@code capsAt} the start and end of each group the
     * program records, or -1 for a group that did not take part. A limit of 0 is none.
     */
    static long exec(Program p, $INPUT$ input, int start, boolean sticky, long limitNanos, int[] caps, int capsAt) {
        State st = State.acquire();
        try {
            return matchWith(p, st, input, start, sticky, limitNanos, caps, capsAt);
        } finally {
            st.release();
        }
    }

    /** The match from {@code start} with the memory {@code st}. */
    static long matchWith(Program p, State st, $INPUT$ input, int start, boolean sticky, long limitNanos, int[] caps,
            int capsAt) {
        st.reset(p, LEN(input), limitNanos);
        boolean found = search(p, st, input, start, sticky);
        int stop = st.stop;
        if (stop == State.STOP_TIME) {
            return STOPPED_TIME;
        }
        if (stop == State.STOP_MEMORY) {
            return STOPPED_MEMORY;
        }
        if (!found) {
            return NO_MATCH;
        }
        if (caps != null) {
            System.arraycopy(st.caps, 0, caps, capsAt, 2 * p.groups);
        }
        return span(st.foundAt, st.end);
    }

    private static boolean search(Program p, State st, $INPUT$ input, int start, boolean sticky) {
        int len = LEN(input);
        int need = $UTF8$ ? p.need : p.need16;
        if (start > len || len - start < need) {
            return false;
        }
        if (sticky || p.anchored) {
            if (p.anchored && start > 0) {
                return false;
            }
            st.foundAt = start;
            return run(p, st, input, start);
        }
        return scan(p, st, input, start, need);
    }

    /** Tries every start from {@code start} that the first set allows. */
    private static boolean scan(Program p, State st, $INPUT$ input, int start, int need) {
        int len = LEN(input);
        boolean units = p.units;
        CharSet first = p.first;
        Search search = p.search;
        int at = start;
        while (true) {
            if (len - at < need) {
                return false;
            }
            if (at == len) {
                st.foundAt = at;
                return first == null && run(p, st, input, at);
            }
            int c = AT(input, at);
            int r;
            int w;
            if (c < 0x80) {
                r = c;
                w = 1;
            } else {
                int rw = $CODEC$.read(input, at, units);
                r = rw >> 3;
                w = rw & 7;
            }
            if (search.leadingWordBoundary && at > 0 && Utf8.isWordUnit(AT(input, at - 1))) {
                // Inside a word, where \b cannot hold: the rest of the word is passed over.
                at = Math.max(endOfRun(p, first, input, at), at + w);
                continue;
            }
            if ((first == null || first.contains(r)) && run(p, st, input, at)) {
                st.foundAt = at;
                return true;
            }
            if (st.stop != State.STOP_NONE) {
                return false;
            }
            if (search.skipRun != null && search.skipRun.contains(r)) {
                // The start failed after its leading loop ate the run from here: every start in the rest of the run
                // fails the same way.
                at = Math.max(endOfRun(p, search.skipRun, input, at + w), at + w);
                continue;
            }
            at += w;
        }
    }

    /** The end of the run of members of the set from {@code at}. */
    static int endOfRun(Program p, CharSet set, $INPUT$ input, int at) {
        int len = LEN(input);
        while (at < len) {
            int c = AT(input, at);
            if (c < 0x80) {
                if (!set.hasAscii(c)) {
                    break;
                }
                at++;
            } else {
                int rw = $CODEC$.read(input, at, p.units);
                if (!set.contains(rw >> 3)) {
                    break;
                }
                at += rw & 7;
            }
        }
        return at;
    }

    /** Whether a way can go on from the position (see Compiler.setQuick). */
    static boolean allows(Program p, int pc, $INPUT$ input, int pos) {
        int f = p.quickFlags[pc];
        if (pos >= LEN(input)) {
            return (f & Program.Q_END) != 0;
        }
        if ((f & Program.Q_MID) != 0) {
            return true;
        }
        int c = AT(input, pos);
        if (c < 0x80) {
            return ((c < 64 ? p.quick0[pc] >>> c : p.quick1[pc] >>> (c - 64)) & 1) != 0;
        }
        return (f & Program.Q_OTHER) != 0;
    }

    /** Whether {@code n} units at {@code a} equal those at {@code b}. */
    private static boolean regionEquals($INPUT$ input, int a, int b, int n) {
//#if UTF8
        return Arrays.equals(input, a, a + n, input, b, b + n);
//#else
        return input.regionMatches(a, input, b, n);
//#endif
    }

    /** Whether the literal of the instruction is at the position. */
    private static boolean litAt(Inst i, $INPUT$ input, int pos) {
//#if UTF8
        byte[] lit = i.lit;
        int n = lit.length;
        return input.length - pos >= n && Arrays.equals(input, pos, pos + n, lit, 0, n);
//#else
        char[] lit = i.lit16;
        int n = lit.length;
        if (input.length() - pos < n) {
            return false;
        }
        for (int k = 0; k < n; k++) {
            if (input.charAt(pos + k) != lit[k]) {
                return false;
            }
        }
        return true;
//#endif
    }

    /**
     * Reports whether the program matches at the position {@code start}. It keeps its choices on an explicit stack, so
     * the depth of the search is bounded by memory and not by the stack of the thread. When it fails, every group and
     * counter is back to the value it had on entry. It counts its steps, and when a check says the match has reached a
     * limit it returns false with the reason in {@code st.stop}.
     */
    static boolean run(Program p, State st, $INPUT$ input, int start) {
        st.sp = 0;
        return runOn(p, st, input, start);
    }

    private static boolean runOn(Program p, State st, $INPUT$ input, int start) {
        Inst[] insts = p.insts;
        // The text is matched by UTF-16 code unit (see Utf8).
        boolean units = p.units;
        int len = LEN(input);
        int pc = 0;
        int pos = start;
        long steps = st.steps;
        // Whether the match has taken the memory of failed places into use.
        boolean memo = st.memoOn;
        run:
        while (true) {
            if (--steps < 0) {
                if (!st.check(st.sp >> 2)) {
                    st.steps = 0;
                    return false;
                }
                steps = State.CHECK_EVERY;
                memo = st.memoOn;
            }
            Inst i = insts[pc];
            switch (i.op) {
                case Inst.CHAR:
                    if (pos < len) {
                        int c = AT(input, pos);
                        if (c < 0x80) {
                            if (c == i.r) {
                                pos++;
                                pc++;
                                continue run;
                            }
                        } else {
                            int rw = $CODEC$.read(input, pos, units);
                            if (rw >> 3 == i.r) {
                                pos += rw & 7;
                                pc++;
                                continue run;
                            }
                        }
                    }
                    break;
                case Inst.SET:
                    if (pos < len) {
                        CharSet set = i.set;
                        int c = AT(input, pos);
                        if (c < 0x80) {
                            if (set.hasAscii(c)) {
                                pos++;
                                pc++;
                                continue run;
                            }
                        } else {
                            int rw = $CODEC$.read(input, pos, units);
                            if (set.contains(rw >> 3)) {
                                pos += rw & 7;
                                pc++;
                                continue run;
                            }
                        }
                    }
                    break;
                case Inst.LIT:
                    if (litAt(i, input, pos)) {
                        pos += $UTF8$ ? i.lit.length : i.lit16.length;
                        pc++;
                        continue run;
                    }
                    break;
                case Inst.CHAR_BACK:
                case Inst.SET_BACK:
                    if (pos > 0) {
                        int c = AT(input, pos - 1);
                        int r;
                        int w;
                        if (c < 0x80) {
                            r = c;
                            w = 1;
                        } else {
                            int rw = $CODEC$.readLast(input, pos, units);
                            r = rw >> 3;
                            w = rw & 7;
                        }
                        if (i.op == Inst.CHAR_BACK ? r == i.r : i.set.contains(r)) {
                            pos -= w;
                            pc++;
                            continue run;
                        }
                    }
                    break;
                case Inst.FAIL:
                    break;
                case Inst.BOL:
                    if (pos == 0) {
                        pc++;
                        continue run;
                    }
                    break;
                case Inst.EOL:
                    if (pos == len) {
                        pc++;
                        continue run;
                    }
                    break;
                case Inst.WORD_BOUNDARY:
                case Inst.NOT_WORD_BOUNDARY: {
                    boolean before = pos > 0 && Utf8.isWordUnit(AT(input, pos - 1));
                    boolean after = pos < len && Utf8.isWordUnit(AT(input, pos));
                    if ((before != after) == (i.op == Inst.WORD_BOUNDARY)) {
                        pc++;
                        continue run;
                    }
                    break;
                }
                case Inst.LINE_START:
                    if (pos == 0 || $CODEC$.lineTerminatorBefore(input, pos)) {
                        pc++;
                        continue run;
                    }
                    break;
                case Inst.LINE_END:
                    if (pos == len || $CODEC$.lineTerminatorAt(input, pos)) {
                        pc++;
                        continue run;
                    }
                    break;
                case Inst.WORD_BOUNDARY_FOLD:
                case Inst.NOT_WORD_BOUNDARY_FOLD: {
                    boolean before = pos > 0 && Fold.isFoldWordRune($CODEC$.decodeLast(input, pos) >> 3);
                    boolean after = pos < len && Fold.isFoldWordRune($CODEC$.decode(input, pos) >> 3);
                    if ((before != after) == (i.op == Inst.WORD_BOUNDARY_FOLD)) {
                        pc++;
                        continue run;
                    }
                    break;
                }
                case Inst.JMP:
                    pc = i.x;
                    continue run;
                case Inst.SPLIT:
                    split: {
                        // A place from which every way has failed before fails at once. The mark is under whatever
                        // comes of this place, a choice or not, so that the place is remembered when it has all failed.
                        if (memo && i.m != 0) {
                            int idx = st.memoIndex(p, i.m, pos);
                            if (st.memoBit(idx)) {
                                break split;
                            }
                            if (st.sp >> 2 < State.MAX_MARK_DEPTH) {
                                st.push(State.E_MARK, 0, idx, 0);
                            }
                        }
                        // A way the next character rules out is not taken, and no choice is kept for it.
                        if (!allows(p, i.y, input, pos)) {
                            if (!allows(p, i.x, input, pos)) {
                                break split;
                            }
                            pc = i.x;
                            continue run;
                        }
                        if (!allows(p, i.x, input, pos)) {
                            pc = i.y;
                            continue run;
                        }
                        st.push(State.E_CHOICE, i.y, pos, 0);
                        pc = i.x;
                        continue run;
                    }
                    break;
                case Inst.SAVE_TMP: {
                    int a = i.a;
                    st.push(State.E_TMP, a, st.tmp[a], 0);
                    st.tmp[a] = pos;
                    pc++;
                    continue run;
                }
                case Inst.CAPTURE: {
                    int a = i.a;
                    int[] caps = st.caps;
                    st.push(State.E_CAP, a, caps[2 * a], caps[2 * a + 1]);
                    if (i.flag) {
                        caps[2 * a] = pos;
                        caps[2 * a + 1] = st.tmp[a];
                    } else {
                        caps[2 * a] = st.tmp[a];
                        caps[2 * a + 1] = pos;
                    }
                    pc++;
                    continue run;
                }
                case Inst.CLEAR: {
                    steps -= i.b - i.a;
                    int[] caps = st.caps;
                    for (int g = i.a; g <= i.b; g++) {
                        if (caps[2 * g] != State.NONE) {
                            st.push(State.E_CAP, g, caps[2 * g], caps[2 * g + 1]);
                            caps[2 * g] = State.NONE;
                            caps[2 * g + 1] = State.NONE;
                        }
                    }
                    pc++;
                    continue run;
                }
                case Inst.BACKREF: {
                    // A group that has not taken part matches the empty string.
                    int a = i.a;
                    int from = st.caps[2 * a];
                    int to = st.caps[2 * a + 1];
                    if (from == State.NONE) {
                        pc++;
                        continue run;
                    }
                    int n = to - from;
                    if (len - pos >= n && regionEquals(input, pos, from, n) && $CODEC$.whole(input, pos, pos + n)) {
                        steps -= n >> 3;
                        pos += n;
                        pc++;
                        continue run;
                    }
                    break;
                }
                case Inst.BACKREF_BACK: {
                    int a = i.a;
                    int from = st.caps[2 * a];
                    int to = st.caps[2 * a + 1];
                    if (from == State.NONE) {
                        pc++;
                        continue run;
                    }
                    int n = to - from;
                    if (pos >= n && regionEquals(input, pos - n, from, n) && $CODEC$.whole(input, pos - n, pos)) {
                        steps -= n >> 3;
                        pos -= n;
                        pc++;
                        continue run;
                    }
                    break;
                }
                case Inst.BACKREF_FOLD:
                case Inst.BACKREF_UNITS: {
                    // A character at a time: to fold case, or because a group matched by code unit can begin or end
                    // between the halves of a character, where its units do not say what it holds.
                    int a = i.a;
                    int from = st.caps[2 * a];
                    int to = st.caps[2 * a + 1];
                    if (from == State.NONE) {
                        pc++;
                        continue run;
                    }
                    steps -= (to - from) >> 3;
                    int at = pos;
                    boolean ok = true;
                    while (from < to && ok) {
                        int want = $CODEC$.read(input, from, units);
                        from += want & 7;
                        if (at >= len) {
                            ok = false;
                            break;
                        }
                        int got = $CODEC$.read(input, at, units);
                        at += got & 7;
                        ok = got >> 3 == want >> 3 || i.op == Inst.BACKREF_FOLD
                                && Fold.canonicalize(got >> 3, i.flag) == Fold.canonicalize(want >> 3, i.flag);
                    }
                    if (ok) {
                        pos = at;
                        pc++;
                        continue run;
                    }
                    break;
                }
                case Inst.BACKREF_FOLD_BACK:
                case Inst.BACKREF_UNITS_BACK: {
                    int a = i.a;
                    int from = st.caps[2 * a];
                    int to = st.caps[2 * a + 1];
                    if (from == State.NONE) {
                        pc++;
                        continue run;
                    }
                    steps -= (to - from) >> 3;
                    int at = pos;
                    boolean ok = true;
                    while (from < to && ok) {
                        int want = $CODEC$.readLast(input, to, units);
                        to -= want & 7;
                        if (at == 0) {
                            ok = false;
                            break;
                        }
                        int got = $CODEC$.readLast(input, at, units);
                        at -= got & 7;
                        ok = got >> 3 == want >> 3 || i.op == Inst.BACKREF_FOLD_BACK
                                && Fold.canonicalize(got >> 3, i.flag) == Fold.canonicalize(want >> 3, i.flag);
                    }
                    if (ok) {
                        pos = at;
                        pc++;
                        continue run;
                    }
                    break;
                }
                case Inst.LOOK:
                    // What follows a lookaround starts where the lookaround does, and so does the body of a lookahead.
                    if (allows(p, pc, input, pos)) {
                        st.push(i.flag ? State.E_LOOK_NEG : State.E_LOOK, i.x, pos, 0);
                        pc++;
                        continue run;
                    }
                    break;
                case Inst.LOOK_OK: {
                    // The body matched. A lookaround is atomic, so the choices made inside it are dropped. The undo
                    // entries stay, because the groups it set remain set until something below this point is retried.
                    int[] s = st.stack;
                    int f = st.sp - 4;
                    while (s[f] != State.E_LOOK) {
                        f -= 4;
                    }
                    pos = s[f + 2];
                    int keep = f;
                    for (int k = f + 4; k < st.sp; k += 4) {
                        if (s[k] >= State.E_TMP) {
                            s[keep] = s[k];
                            s[keep + 1] = s[k + 1];
                            s[keep + 2] = s[k + 2];
                            s[keep + 3] = s[k + 3];
                            keep += 4;
                        }
                    }
                    st.sp = keep;
                    pc++;
                    continue run;
                }
                case Inst.LOOK_FAIL:
                    // The body of a negative lookaround matched, so the lookaround fails and everything it did is
                    // undone.
                    while (st.sp > 0) {
                        st.sp -= 4;
                        if (st.stack[st.sp] == State.E_LOOK_NEG) {
                            break;
                        }
                        st.undo(st.sp);
                    }
                    break;
                case Inst.REP:
                    rep: {
                        int at = pos;
                        int n = 0;
                        int floor = pos;
                        if (i.set != null) {
                            CharSet set = i.set;
                            while (n != i.max && at < len) {
                                int c = AT(input, at);
                                if (c < 0x80) {
                                    if (!set.hasAscii(c)) {
                                        break;
                                    }
                                    at++;
                                } else {
                                    int rw = $CODEC$.read(input, at, units);
                                    if (!set.contains(rw >> 3)) {
                                        break;
                                    }
                                    at += rw & 7;
                                }
                                n++;
                                if (n == i.min) {
                                    floor = at;
                                }
                            }
                        } else {
                            while (n != i.max && at < len) {
                                int c = AT(input, at);
                                int r;
                                int w;
                                if (c < 0x80) {
                                    r = c;
                                    w = 1;
                                } else {
                                    int rw = $CODEC$.read(input, at, units);
                                    r = rw >> 3;
                                    w = rw & 7;
                                }
                                if (r != i.r) {
                                    break;
                                }
                                at += w;
                                n++;
                                if (n == i.min) {
                                    floor = at;
                                }
                            }
                        }
                        steps -= (at - pos) >> 3;
                        if (n >= i.min) {
                            if (memo && i.m != 0) {
                                int idx = st.memoIndex(p, i.m, at);
                                if (st.memoBit(idx)) {
                                    // What follows the loop has failed from here before. The loop gives a character
                                    // back.
                                    if (at > floor) {
                                        st.push(State.E_REP, pc + 1, at, floor);
                                    }
                                    break rep;
                                }
                                if (at == floor && st.sp >> 2 < State.MAX_MARK_DEPTH) {
                                    st.push(State.E_MARK, 0, idx, 0);
                                }
                            }
                            if (at > floor) {
                                st.push(State.E_REP, pc + 1, at, floor);
                            }
                            pos = at;
                            pc++;
                            continue run;
                        }
                    }
                    break;
                case Inst.REP_LAZY:
                    rep: {
                        int at = pos;
                        int n = 0;
                        while (n < i.min) {
                            int w = one(i, input, at, units);
                            if (w == 0) {
                                break;
                            }
                            at += w;
                            n++;
                        }
                        steps -= n >> 3;
                        if (n == i.min) {
                            if (memo && i.m != 0) {
                                int idx = st.memoIndex(p, i.m, at);
                                if (st.memoBit(idx)) {
                                    // What follows the loop has failed from here before. The loop takes one more.
                                    if (n != i.max) {
                                        st.push(State.E_REP_LAZY, pc, at, n);
                                    }
                                    break rep;
                                }
                                if (n == i.max && st.sp >> 2 < State.MAX_MARK_DEPTH) {
                                    st.push(State.E_MARK, 0, idx, 0);
                                }
                            }
                            if (n != i.max) {
                                st.push(State.E_REP_LAZY, pc, at, n);
                            }
                            pos = at;
                            pc++;
                            continue run;
                        }
                    }
                    break;
                case Inst.LOOP_INIT: {
                    int a = i.a;
                    int[] counts = st.counts;
                    st.push(State.E_COUNTER, a, counts[2 * a], counts[2 * a + 1]);
                    counts[2 * a] = 0;
                    counts[2 * a + 1] = State.NONE;
                    pc++;
                    continue run;
                }
                case Inst.LOOP:
                    looping: {
                        int a = i.a;
                        long n = st.counts[2 * a];
                        long min = i.min;
                        long need = $UTF8$ ? i.need : i.need16;
                        long left = len - pos;
                        long iter = $UTF8$ ? i.iter : i.iter16;
                        // Fewer units are left than any way from here to a match consumes: what follows the loop, and
                        // the iterations it has still to make.
                        if (left < need || n < min && iter != 0 && left - need < (min - n) * iter) {
                            break looping;
                        }
                        // Once the minimum is met, ECMA-262 rejects an iteration that consumed nothing. That is what
                        // stops a loop over a body that can be empty.
                        if (n > min && pos == st.counts[2 * a + 1]) {
                            break looping;
                        }
                        if (n < min) {
                            pc++;
                            continue run;
                        }
                        if (i.max >= 0 && n >= i.max) {
                            pc = i.x;
                            continue run;
                        }
                        // The loop may be left or entered from here. A place from which both have failed before fails
                        // at once.
                        if (memo && i.m != 0) {
                            int idx = st.memoIndex(p, i.m, pos);
                            if (st.memoBit(idx)) {
                                break looping;
                            }
                            if (st.sp >> 2 < State.MAX_MARK_DEPTH) {
                                st.push(State.E_MARK, 0, idx, 0);
                            }
                        }
                        if (!allows(p, i.x, input, pos)) {
                            // The next character rules out leaving the loop, so there is no choice.
                            pc++;
                        } else if (!allows(p, pc + 1, input, pos)) {
                            pc = i.x;
                        } else if (i.flag) {
                            st.push(State.E_CHOICE, pc + 1, pos, 0);
                            pc = i.x;
                        } else {
                            st.push(State.E_CHOICE, i.x, pos, 0);
                            pc++;
                        }
                        continue run;
                    }
                    break;
                case Inst.LOOP_ITER: {
                    int a = i.a;
                    int[] counts = st.counts;
                    st.push(State.E_COUNTER, a, counts[2 * a], counts[2 * a + 1]);
                    counts[2 * a]++;
                    counts[2 * a + 1] = pos;
                    pc++;
                    continue run;
                }
                case Inst.MATCH:
                    st.steps = steps;
                    st.end = pos;
                    return true;
                default:
                    throw new IllegalStateException("op " + i.op);
            }
            // The instruction failed. Take up the most recent choice, undoing what was recorded since.
            backtrack:
            while (true) {
                if (st.sp == 0) {
                    st.steps = steps;
                    return false;
                }
                int top = st.sp - 4;
                int[] s = st.stack;
                int ePc = s[top + 1];
                int ePos = s[top + 2];
                int eA = s[top + 3];
                switch (s[top]) {
                    case State.E_CHOICE:
                        pc = ePc;
                        pos = ePos;
                        st.sp = top;
                        break backtrack;
                    case State.E_REP: {
                        // What followed the loop from the position it stood at has failed.
                        Inst rep = insts[ePc - 1];
                        boolean marked = memo && rep.m != 0;
                        if (marked) {
                            st.setMemoBit(st.memoIndex(p, rep.m, ePos));
                        }
                        // Give back the last character taken. The characters between a and pos were decoded going
                        // forward, and decoding the last of them going backward finds the same boundary.
                        int at = ePos - $CODEC$.giveBack(input, eA, ePos, units);
//#if UTF8
                        if (rep.back.length > 0 && at > eA && !allows(p, ePc, input, at)) {
                            // What follows the loop can only start with one of a few ASCII bytes: the last of them
                            // before here is found going back, and the positions after it are passed over at once.
                            at = eA + lastOf(rep.back, input, eA, at);
                        }
//#endif
                        s[top + 2] = at;
                        pc = ePc;
                        pos = at;
                        boolean last = at <= eA;
                        // A position from which what follows the loop cannot go on is passed over, and so is one from
                        // which it has failed before.
                        boolean pass = !allows(p, pc, input, pos);
                        if (marked && !pass) {
                            int idx = st.memoIndex(p, rep.m, pos);
                            if (st.memoBit(idx)) {
                                pass = true;
                            } else if (last) {
                                // The loop has nothing more to give back. The entry stays to note this last way.
                                s[top] = State.E_MARK;
                                s[top + 1] = 0;
                                s[top + 2] = idx;
                                s[top + 3] = 0;
                                break backtrack;
                            }
                        }
                        if (last) {
                            st.sp = top;
                        }
                        if (pass) {
                            steps--;
                            continue backtrack;
                        }
                        break backtrack;
                    }
                    case State.E_REP_LAZY: {
                        // What followed the loop from the position it stood at has failed.
                        Inst rep = insts[ePc];
                        boolean marked = memo && rep.m != 0;
                        if (marked) {
                            st.setMemoBit(st.memoIndex(p, rep.m, ePos));
                        }
                        int w = one(rep, input, ePos, units);
                        if (w == 0) {
                            st.sp = top;
                            continue backtrack;
                        }
                        int at = ePos + w;
                        int taken = eA + 1;
                        s[top + 2] = at;
                        s[top + 3] = taken;
                        pc = ePc + 1;
                        pos = at;
                        boolean last = taken == rep.max;
                        if (marked) {
                            int idx = st.memoIndex(p, rep.m, pos);
                            if (st.memoBit(idx)) {
                                if (last) {
                                    st.sp = top;
                                }
                                steps--;
                                continue backtrack;
                            }
                            if (last) {
                                s[top] = State.E_MARK;
                                s[top + 1] = 0;
                                s[top + 2] = idx;
                                s[top + 3] = 0;
                                break backtrack;
                            }
                        }
                        if (last) {
                            st.sp = top;
                        }
                        break backtrack;
                    }
                    case State.E_MARK:
                        // Every way from a memo point has failed.
                        st.setMemoBit(ePos);
                        st.sp = top;
                        break;
                    case State.E_LOOK:
                        // The body of a positive lookaround has no way left to match.
                        st.sp = top;
                        break;
                    case State.E_LOOK_NEG:
                        // The body of a negative lookaround has no way to match, so the lookaround holds.
                        pc = ePc;
                        pos = ePos;
                        st.sp = top;
                        break backtrack;
                    default:
                        st.undo(top);
                        st.sp = top;
                        break;
                }
            }
        }
    }

//#if UTF8
    /** The offset in {@code input[from..to]} of the last of the bytes, or 0 when none is there. */
    private static int lastOf(byte[] bytes, byte[] input, int from, int to) {
        for (int k = to - 1; k >= from; k--) {
            byte b = input[k];
            for (byte x : bytes) {
                if (b == x) {
                    return k - from;
                }
            }
        }
        return 0;
    }

//#endif
    /**
     * The width of the character at the position {@code at} when the instruction's character or class matches it, and
     * 0 otherwise. The character is a code unit with {@code units} set.
     */
    static int one(Inst i, $INPUT$ input, int at, boolean units) {
        if (at >= LEN(input)) {
            return 0;
        }
        int c = AT(input, at);
        int r;
        int w;
        if (c < 0x80) {
            r = c;
            w = 1;
        } else {
            int rw = $CODEC$.read(input, at, units);
            r = rw >> 3;
            w = rw & 7;
        }
        if (i.set != null) {
            if (!i.set.contains(r)) {
                return 0;
            }
        } else if (r != i.r) {
            return 0;
        }
        return w;
    }
}
